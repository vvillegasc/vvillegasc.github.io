---
import PageLayout from '../../../layouts/PageLayout.astro';
import Card from '../../../components/Card.astro';
import BackLink from '../../../components/BackLink.astro';
import { withBase } from '../../../utils/slugify';

const temas = [
	{ title: 'Bases de Datos', description: 'Archivos, DBMS y conceptos base.', href: '/evidencias/apuntes/bases-de-datos' },
	{ title: 'Modelo Entidad Relación', description: 'Entidades, atributos, cardinalidad y MER extendido.', href: '/evidencias/apuntes/modelo-entidad-relacion' },
	{ title: 'Transformación del MER al Modelo Relacional', description: 'Reglas para pasar de entidades y relaciones a tablas.', href: '/evidencias/apuntes/transformacion-mer-modelo-relacional' },
	{ title: 'Modelo Relacional', description: 'Claves, integridad, restricciones y notaciones.', href: '/evidencias/apuntes/modelo-relacional' },
	{ title: 'Normalización', description: 'Dependencias funcionales, anomalías y formas normales.', href: '/evidencias/apuntes/normalizacion' },
	{ title: 'SQL', description: 'SQL estándar: DDL, DML, consultas, JOINs, subconsultas y transacciones.', href: '/evidencias/apuntes/sql' },
	{ title: 'Oracle', description: 'Esquema HR, tipos, funciones y lo que cambia frente al SQL estándar.', href: '/evidencias/apuntes/oracle' },
];
---

<PageLayout title="Apuntes · Evidencias" description="Apuntes de teoría del curso de Bases de Datos 1.">
	<section class="content-shell py-12 space-y-8">
		<header class="space-y-3 max-w-3xl">
			<BackLink href="/evidencias" label="Volver a Evidencias" />
			<p class="eyebrow m-0">Evidencias</p>
			<h1 class="text-3xl sm:text-4xl font-semibold leading-tight text-ink">Apuntes</h1>
			<p class="text-muted">Notas de teoría del curso, organizadas por tema. Se irán llenando durante el semestre.</p>
		</header>

		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{temas.map((item) => (
				<Card title={item.title} description={item.description} href={withBase(item.href)} />
			))}
		</div>
	</section>
</PageLayout>
