---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import Presentacion from '../components/Presentacion.astro';
import PostList from '../components/PostList.astro';
import Numbers from '../components/Numbers.astro';
import Skills from '../components/Skills.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';
import { getSite } from '../utils/consts';
import { withBase } from '../utils/slugify';
import logo from '../assets/LogoPortfolio.png';
const site = await getSite();

const evidencias = [
	{ title: 'Modelado', description: 'Próximamente.', href: '/evidencias/modelado' },
	{ title: 'Normalización', description: 'Próximamente.', href: '/evidencias/normalizacion' },
	{ title: 'SQL', description: 'Próximamente.', href: '/evidencias/sql' },
	{ title: 'Proyecto', description: 'Próximamente.', href: '/evidencias/proyecto' },
];

const projects = (await getCollection('projects'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((project) => ({
		title: project.data.title,
		description: project.data.description,
		heroImage: project.data.heroImage,
		pubDate: project.data.pubDate,
		href: `/projects/${project.id}/`,
	}));
---

<PageLayout
	title={site.title}
>
	<Hero
		id="inicio"
		eyebrow="Inicio"
		title="Hola, soy Valentina Villegas"
		description="[Escribe aquí una frase breve sobre ti: qué estudias, un interés o algo que te represente.]"
		logo={logo}
		logoAlt="Valentina Villegas"
		actions={[
			{ label: 'Ver Evidencias', href: '/evidencias' },
			{ label: 'Ver Proyectos', href: '/projects' },
		]}
	/>

	<Presentacion
		id="presentacion"
		eyebrow="Preséntate"
		title="Presentación"
		copy="Sobre mí"
		videoEmbedUrl="https://www.youtube.com/embed/9lrMD6BuXSg"
	/>

	<Skills
		id="habilidades"
		eyebrow="Habilidades"
		title="Habilidades"
		copy="Tecnologías y herramientas con las que trabajo"
		skills={[
			'JavaScript',
			'TypeScript',
			'React',
			'Angular',
			'Astro',
			'HTML5',
			'CSS',
			'Node.js',
			'SQL',
			'Git',
			'AWS',
			'REST APIs',
			'ClickUp',
		]}
	/>

	<PostList
		id="proyectos"
		eyebrow="Trabajo"
		heading="Proyectos"
		copy="Mis trabajos"
		posts={projects}
		limit={3}
		viewAllHref="/projects"
		viewAllLabel="Ver todos los proyectos"
	/>

	<section id="evidencias" class="space-y-6">
		<header class="space-y-2 max-w-2xl">
			<p class="eyebrow m-0">Evidencias</p>
			<h2 class="text-3xl sm:text-4xl font-semibold leading-tight text-ink m-0">Evidencias</h2>
			<p class="text-muted m-0">Modelado · Normalización · SQL · Proyecto — se irán llenando durante el semestre.</p>
		</header>
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{evidencias.map((item) => (
				<Card title={item.title} description={item.description} href={withBase(item.href)} />
			))}
		</div>
	</section>

</PageLayout>
