---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Action {
	label: string;
	href: string;
}

interface Props {
	id?: string;
	eyebrow?: string;
	title: string;
	description?: string;
	actions?: Action[];
	logo?: ImageMetadata | string;
	logoAlt?: string;
}

import { withBase } from '../utils/slugify';

const { id, eyebrow, title, description, actions = [], logo, logoAlt = '' } = Astro.props;
---

<section id={id} class="content-shell flex items-center">
	<div class="grid gap-10 items-center w-full md:grid-cols-[1fr_auto]">
		<div class="grid gap-4 max-w-2xl">
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			<h1 class="text-4xl md:text-5xl lg:text-6xl leading-tight m-0">{title}</h1>
			{description && <p class="text-muted text-base md:text-lg max-w-2xl m-0">{description}</p>}
			{actions.length > 0 && (
				<div class="flex flex-wrap gap-3 mt-3">
					{actions.map((action) => (
						<a class="button primary" href={withBase(action.href)}>
							{action.label}
						</a>
					))}
				</div>
			)}
		</div>
		{logo && (
			typeof logo === 'string' ? (
				<img src={logo} alt={logoAlt} class="h-44 w-44 md:h-64 md:w-64 lg:h-80 lg:w-80 rounded-full object-cover border border-border shrink-0 justify-self-center md:justify-self-end" />
			) : (
				<Image src={logo} alt={logoAlt} class="h-44 w-44 md:h-64 md:w-64 lg:h-80 lg:w-80 rounded-full object-cover border border-border shrink-0 justify-self-center md:justify-self-end" />
			)
		)}
	</div>
</section>

<style>
	.content-shell {
		min-height: calc(100vh - calc(var(--grid-cell) * 1));
	}

	@media (max-width: 720px) {
		.content-shell {
			min-height: calc(100vh - calc(var(--grid-cell) * 4));
		}
	}
</style>
