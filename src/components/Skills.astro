---
import { Icon } from 'astro-icon/components';

interface Props {
	id?: string;
	eyebrow?: string;
	title?: string;
	copy?: string;
	skills?: string[];
}

const {
	id,
	eyebrow,
	title = 'Habilidades',
	copy,
	skills = [],
} = Astro.props as Props;

const iconMap: Record<string, string> = {
	javascript: 'tabler:brand-javascript',
	typescript: 'tabler:brand-typescript',
	react: 'tabler:brand-react',
	astro: 'tabler:brand-astro',
	html5: 'tabler:brand-html5',
	css3: 'tabler:brand-css3',
	'node.js': 'tabler:brand-nodejs',
	sql: 'tabler:sql',
	git: 'tabler:brand-git',
	aws: 'tabler:brand-aws',
	'rest apis': 'tabler:api',
	clickup: 'tabler:layout-kanban',
	postgresql: 'tabler:database',
	angular: 'tabler:brand-angular',
	redux: 'tabler:brand-redux',
	'next.js': 'tabler:brand-nextjs',
	express: 'tabler:server',
	tailwind: 'tabler:brand-tailwind',
};
---

<section id={id} class="space-y-6">
	<header class="space-y-2 max-w-2xl">
		{eyebrow && <p class="eyebrow m-0">{eyebrow}</p>}
		{title && <h2 class="text-3xl sm:text-4xl font-semibold leading-tight text-ink m-0">{title}</h2>}
		{copy && <p class="text-muted m-0">{copy}</p>}
	</header>

	{skills.length > 0 && (
		<ul class="flex flex-wrap gap-3 list-none p-0 m-0">
			{skills.map((skill) => {
				const iconName = iconMap[skill.toLowerCase()] ?? 'tabler:point-filled';
				return (
					<li>
						<span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-2 text-sm font-medium text-ink transition duration-150 ease-out hover:-translate-y-0.5 hover:border-[color-mix(in_oklab,var(--color-ink)_28%,transparent)]">
							<Icon name={iconName} size={18} stroke-width={1.6} />
							{skill}
						</span>
					</li>
				);
			})}
		</ul>
	)}
</section>
