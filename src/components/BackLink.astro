---
import { Icon } from 'astro-icon/components';
import { withBase } from '../utils/slugify';

interface Props {
	href: string;
	label?: string;
}

const { href, label = 'Volver' } = Astro.props as Props;
---

<a
	href={withBase(href)}
	class="inline-flex items-center gap-1.5 text-sm font-medium text-muted no-underline transition-colors duration-150 hover:text-ink"
>
	<Icon name="tabler:arrow-left" size={16} stroke-width={2} />
	{label}
</a>
